# experiment artefacts: per-program directories (binaries, traces, logs) and run logs;
# only the result tables (*.csv) and generated documents are committed
experiments/results/*/*/
# the first-read maps are an input of the tables, not a run directory
!experiments/results/reads/mbi/
experiments/results/*.log
!experiments/results/timing-leg.log
experiments/results/e4/*.log
experiments/results/e4/*.err
experiments/results/e4/*.report.txt
experiments/results/hypre/predict*.log
experiments/results/hypre/stress*.log
experiments/results/amg/*
!experiments/results/amg/summary8.txt
!experiments/results/amg/confirm8.txt
!experiments/results/amg/replay_sample.csv
!experiments/results/amg/must8-*/
experiments/results/amg/must8-*/*
!experiments/results/amg/must8-*/verdict.txt
!experiments/results/amg/must8-*/run.out
third_party/*.log
experiments/results/*/must.csv
experiments/results/*/must.log
experiments/results/must.done
experiments/results/nekbone/*
# the MPI-PRV baseline's builds, runs and traces (experiments/mpiprv/)
experiments/mpiprv/work/
!experiments/results/nekbone/summary8.txt
!experiments/results/nekbone/replay_sample.csv
# the scale campaign (experiments/scale/run.sh): per trace the sample's rows and log, the analysis
# time and the traced run's output; not the reports (AMG's at 64 processes is 200 MB), the empty
# error logs, or AMG's run logs, almost all Open MPI warnings naming host and process
!experiments/results/scale/samples/
experiments/results/scale/samples/*
!experiments/results/scale/samples/*.csv
!experiments/results/scale/samples/*.sample
!experiments/results/scale/samples/*.time
!experiments/results/scale/samples/hypre-*.run
!experiments/results/scale/samples/lu-*.run
# the commit the sync writes on the experiment machine
/COMMIT
# what artifact/reproduce.sh writes: logs and the numbers the paper was built with
/artifact/out/
