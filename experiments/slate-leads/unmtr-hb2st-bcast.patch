+    // Broadcast every V(0, r) first, in one order on every rank. Inside the
+    // tasks below, each rank's threads took the broadcasts in the order its
+    // scheduler picked them; a root blocked in Waitall on a large send while
+    // every thread of the receiver was blocked in another task's broadcast,
+    // and the ranks deadlocked once no thread was left free.
+    for (int j2 = mt-1; j2 > -mt; --j2) {
+        for (int j = 0; j < mt; ++j) {
+            int i = 2*j - j2;
+            if (j <= i && i < mt) {
+                int64_t r = i - j + j*mt - j*(j-1)/2;
+                V.tileBcast(0, r, C.sub(i, i, 0, nt-1), Layout::ColMajor, j);
+            }
+        }
+    }
+
