+    if( es != &parsec_comm_es ) {
+        parsec_context_t *context = es->virtual_process->parsec_context;
+        for( int p = 0; p < es->virtual_process->vp_id; p++ )
+            tag += context->virtual_processes[p]->nb_cores;
+        tag += es->th_id + 1;
+    }
     rc = MPI_Sendrecv((char*)PARSEC_DATA_COPY_GET_PTR(src) + displ_src,
-                      count_src, layout_src, 0, es->th_id,
+                      count_src, layout_src, 0, tag,
                       (char*)PARSEC_DATA_COPY_GET_PTR(dst) + displ_dst,
-                      count_dst, layout_dst, 0, es->th_id,
+                      count_dst, layout_dst, 0, tag,
                       parsec_ce_mpi_self_comm, MPI_STATUS_IGNORE);
     (void)ce;
     return (MPI_SUCCESS == rc ? 0 : -1);
 }
