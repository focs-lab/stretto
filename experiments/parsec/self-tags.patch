--- a/parsec/parsec_mpi_funnelled.c
+++ b/parsec/parsec_mpi_funnelled.c
@@ -495,15 +495,26 @@
                         uint64_t count_src)
 {
-    int rc;
+    int rc, tag = 0;
     PARSEC_DEBUG_VERBOSE(20, parsec_comm_output_stream,
                          "COPY LOCAL DATA from %p (%d elements of dtt %p) to %p (%d elements of dtt %p)",
                          PARSEC_DATA_COPY_GET_PTR(src) + displ_src, count_src, layout_src,
                          PARSEC_DATA_COPY_GET_PTR(dst) + displ_dst, count_dst, layout_dst);
+    /* With PARSEC_CONTEXT_FLAG_COMM_MT every thread reshapes on parsec_ce_mpi_self_comm, so
+     * the tag must tell the calling threads apart. es->th_id does not: it numbers the threads
