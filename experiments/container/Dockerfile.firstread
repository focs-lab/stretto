# The static first-read analysis (analysis/stretto/firstread, docs/firstread.md) reads the
# LLVM IR that clang 18 emits for a program's C sources. The experiment image has no clang, and
# the committed results come from it unchanged, so the tool gets an image of its own: the
# experiment image plus clang 18 from the same archive snapshot, pinned by version
# (versions-firstread.txt lists what the layer adds). Nothing is compiled while it builds.
# Build:  docker build --cpuset-cpus 6-9 -t stretto-firstread:24.04 -f experiments/container/Dockerfile.firstread experiments/container
FROM stretto-exp:24.04
ARG SNAPSHOT=20261007T095400Z
RUN apt-get update --snapshot "$SNAPSHOT" \
 && apt-get install -y --no-install-recommends --snapshot "$SNAPSHOT" \
      clang-18=1:18.1.3-1ubuntu1 libclang-common-18-dev=1:18.1.3-1ubuntu1 \
      libclang-cpp18=1:18.1.3-1ubuntu1 libllvm18=1:18.1.3-1ubuntu1 \
 && rm -rf /var/lib/apt/lists/*
