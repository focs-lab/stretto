# Where the builds of the thread campaigns, MUST-vc and the L1+L lock replays are on a-p13
# (experiments/protocol/external.py reads this file when MACHINE=a-p13). They are the builds of the
# committed campaigns that are still on the machine, under the home directory; a block whose build
# is missing ends with "missing-build" in the journal and runs nothing.
# SLATE: experiments/slate/build-lib.sh's libraries (lib/, lib-mpich/: plain/ and fixed/) and drivers
# (wide_lu, wide_lu-mpich), built by experiments/protocol/build_threads.sh slate into SLATE_HOME
SLATE_IMAGE=hunt-slate:24.04
SLATE_HOME=$HOME/protocol/threads/slate
# DLA-Future and PaRSEC: the builds of experiments/atomics (the traced-atomics campaigns), in its image,
# linked against the tracer's stub runtime (tracer/bin/libstretto-tsan.so, make -C tracer)
DLAF_IMAGE=atm-clang:24.04
DLAF_BUILD=$HOME/atm-work/dlaf
DLAF_BUILD_IN=/h/bin
DLAF_LD_LIBRARY_PATH=/w/tracer/bin
PARSEC_IMAGE=atm-clang:24.04
PARSEC_BUILD=$HOME/atm-work/parsec
PARSEC_BUILD_IN=/h/build-tsan
PARSEC_LD_LIBRARY_PATH=/w/tracer/bin
# Uintah (experiments/uintah/build.sh): the plain and fixed sus per MPI, Open MPI's built by
# build_threads.sh uintah, MPICH's that of experiments/uintah, each mounted where it was built (the
# binaries' runpaths), with the Uintah tree of MUST-vc (493d2b5), whose ups_spec.xml sus reads, as
# host:container pairs; and the 8-patch input of run.sh
UINTAH_IMAGE=stretto-uintah:24.04
UINTAH_ROOT_IN=/h
UINTAH_MOUNTS=$HOME/protocol/threads/uintah-openmpi:/h,$HOME/mvc-work/src/uintah:/usrc
UINTAH_MPICH_ROOT_IN=/x
UINTAH_MPICH_MOUNTS=$HOME/uin-work:/x,$HOME/mvc-work/src/uintah:/usrc
UINTAH_MPICH_PLAIN_SUS=mpich/plain/StandAlone/sus
UINTAH_MPICH_FIX_SUS=mpich/fix/StandAlone/sus
UINTAH_UPS=$HOME/mvc-work/runs/apps-uintah/solvertest-8p.ups
# MUST-vc (experiments/mustvc/build-apps.sh): the work directory mounted at /mvc, its parsec/, dlaf/
# and dlaf-openmpi/ at /h, its src/ (the sources Uintah's build links to) at /src; the image for
# the MPICH blocks (the Open MPI block's, mustvc:1.9-omp-openmpi, is the plan's)
MUSTVC_IMAGE=mustvc:1.9-omp
MUSTVC_WORK=$HOME/mvc-work
# the L1+L lock replays: MPI-CorrBench's OpenMP programs and MUST-vc's artifact tests
LOCKS_CORRBENCH_OPENMP=$HOME/mvc-work/corrbench
LOCKS_ARTIFACT_TESTS=$HOME/mvc-work/artifact/tests
